Project tourism_ecosystem {
  database_type: 'PostgreSQL'
}

Table roles {
  role_id serial [pk]
  role_name varchar(50) [not null, unique]
  description varchar(255)
}

Table users {
  user_id bigserial [pk]
  role_id int [not null, ref: > roles.role_id]
  email varchar(150) [not null]
  password_hash varchar(255) [not null]
  full_name varchar(150) [not null]
  phone varchar(30)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by_user_id bigint [ref: > users.user_id]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_by_user_id bigint [ref: > users.user_id]
}

Table tourist_profiles {
  user_id bigint [pk, ref: - users.user_id]
  passport_number varchar(30) [not null, unique]
  citizenship char(2) [not null]
  birth_date date [not null]
  emergency_contact varchar(150)
  preferences jsonb [not null, default: `'{}'`]
}

Table countries {
  country_id serial [pk]
  iso_code char(2) [not null, unique]
  country_name varchar(100) [not null, unique]
  visa_required boolean [not null, default: false]
}

Table cities {
  city_id serial [pk]
  country_id int [not null, ref: > countries.country_id]
  city_name varchar(100) [not null]
  timezone varchar(50) [not null, default: 'UTC']

  indexes {
    (country_id, city_name) [unique]
  }
}

Table locations {
  location_id bigserial [pk]
  city_id int [not null, ref: > cities.city_id]
  parent_location_id bigint [ref: > locations.location_id]
  location_name varchar(150) [not null]
  category varchar(50) [not null]
  description text
}

Table agencies {
  agency_id bigserial [pk]
  agency_name varchar(150) [not null]
  license_number varchar(50) [not null, unique]
  contact_email varchar(150) [not null]
  phone varchar(30) [not null]
  rating numeric(3,2) [not null, default: 5.00]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by_user_id bigint [ref: > users.user_id]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_by_user_id bigint [ref: > users.user_id]
}

Table hotels {
  hotel_id bigserial [pk]
  city_id int [not null, ref: > cities.city_id]
  hotel_name varchar(150) [not null]
  stars smallint [not null]
  address varchar(255) [not null]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_by_user_id bigint [ref: > users.user_id]
}

Table room_types {
  room_type_id bigserial [pk]
  hotel_id bigint [not null, ref: > hotels.hotel_id]
  type_name varchar(100) [not null]
  capacity smallint [not null]
  base_price_per_night numeric(10,2) [not null]
}

Table transport_providers {
  provider_id serial [pk]
  provider_name varchar(150) [not null, unique]
  transport_type varchar(20) [not null]
  contact_phone varchar(30)
}

Table tours {
  tour_id bigserial [pk]
  agency_id bigint [not null, ref: > agencies.agency_id]
  title varchar(200) [not null]
  tour_code varchar(30) [not null, unique]
  base_price numeric(12,2) [not null]
  duration_days smallint [not null]
  max_group_size smallint [not null]
  tags text[] [not null, default: `'{}'`]
  status varchar(20) [not null, default: 'Active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by_user_id bigint [ref: > users.user_id]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_by_user_id bigint [ref: > users.user_id]
}

Table tour_departures {
  departure_id bigserial [pk]
  tour_id bigint [not null, ref: > tours.tour_id]
  provider_id int [ref: > transport_providers.provider_id]
  start_date date [not null]
  end_date date [not null]
  price_override numeric(12,2)
  total_seats smallint [not null]
  available_seats smallint [not null]
  status varchar(20) [not null, default: 'Scheduled']
}

Table tour_itinerary_stages {
  stage_id bigserial [pk]
  tour_id bigint [not null, ref: > tours.tour_id]
  day_number smallint [not null]
  location_id bigint [not null, ref: > locations.location_id]
  room_type_id bigint [ref: > room_types.room_type_id]
  stage_title varchar(150) [not null]
  description text

  indexes {
    (tour_id, day_number) [unique]
  }
}

Table excursions {
  excursion_id bigserial [pk]
  location_id bigint [not null, ref: > locations.location_id]
  guide_user_id bigint [ref: > users.user_id]
  title varchar(150) [not null]
  duration_hours numeric(4,1) [not null]
  price numeric(10,2) [not null]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_by_user_id bigint [ref: > users.user_id]
}

Table promotions {
  promotion_id bigserial [pk]
  promo_code varchar(30) [not null, unique]
  discount_percent numeric(5,2) [not null]
  valid_from date [not null]
  valid_to date [not null]
  max_uses int [not null]
  current_uses int [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table bookings {
  booking_id bigserial [pk]
  booking_number varchar(40) [not null, unique]
  user_id bigint [not null, ref: > users.user_id]
  departure_id bigint [not null, ref: > tour_departures.departure_id]
  promotion_id bigint [ref: > promotions.promotion_id]
  participants_count smallint [not null]
  total_amount numeric(12,2) [not null]
  booking_status varchar(20) [not null, default: 'Pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by_user_id bigint [ref: > users.user_id]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_by_user_id bigint [ref: > users.user_id]
}

Table booking_excursions {
  booking_id bigint [not null, ref: > bookings.booking_id]
  excursion_id bigint [not null, ref: > excursions.excursion_id]
  attendees_count smallint [not null]
  fixed_price numeric(10,2) [not null]

  indexes {
    (booking_id, excursion_id) [pk]
  }
}

Table payments {
  payment_id bigserial [pk]
  booking_id bigint [not null, ref: > bookings.booking_id]
  amount numeric(12,2) [not null]
  currency char(3) [not null, default: 'USD']
  payment_method varchar(30) [not null]
  external_tx_ref varchar(100) [not null, unique]
  payment_status varchar(20) [not null, default: 'Completed']
  paid_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by_user_id bigint [ref: > users.user_id]
}

Table reviews {
  review_id bigserial [pk]
  booking_id bigint [not null, unique, ref: - bookings.booking_id]
  user_id bigint [not null, ref: > users.user_id]
  tour_id bigint [not null, ref: > tours.tour_id]
  rating smallint [not null]
  comment text
  created_at timestamptz [not null, default: `now()`]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_by_user_id bigint [ref: > users.user_id]
}

Table audit_logs {
  log_id bigserial [pk]
  table_name varchar(64) [not null]
  record_id bigint [not null]
  operation_type varchar(20) [not null]
  changed_by_user_id bigint [ref: > users.user_id]
  changed_at timestamptz [not null, default: `now()`]
  old_values jsonb
  new_values jsonb
}